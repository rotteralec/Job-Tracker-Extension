{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "0.3.0",
  "description": "Log job applications (and their full descriptions) to a Google Sheet with one click.",

  "action": {
    "default_title": "Log this job application"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "options_page": "options.html",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],

  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
